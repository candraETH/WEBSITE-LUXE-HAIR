PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
APP_BASE_URL=http://localhost:3000
# Optional alias for compatibility with older config naming:
# PAYPAL_WEBHOOK_SECRET=your_paypal_webhook_id
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Required in production (rate-limit + OTP/session store):
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
# Required in production (OTP hashing):
OTP_HASH_SECRET=your_random_otp_hash_secret
# Optional delivery bridge. If empty in development, OTP code is returned as `devOtpCode`.
OTP_DELIVERY_WEBHOOK_URL=
OTP_DELIVERY_WEBHOOK_BEARER=
